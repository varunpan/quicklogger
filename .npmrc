engine-strict=true

# Supply-chain hardening — see docs/deployment.md § "Supply-chain hardening".
# The last three keys need npm 11 (Node 24's bundled npm); older npm ignores them.

# Never run dependency lifecycle scripts (preinstall/install/postinstall) on
# install. `npm test` / `npm run <x>` still run; only pre/post hooks are skipped.
ignore-scripts=true

# Only resolve versions published at least 7 days ago, so a hijacked release has
# time to be caught and pulled first. Versions already in package-lock.json still
# install. Matches the npm `cooldown` in .github/dependabot.yml.
min-release-age=7

# Registry packages only: no git or tarball-URL dependencies anywhere in the tree.
allow-git=none
allow-remote=none
